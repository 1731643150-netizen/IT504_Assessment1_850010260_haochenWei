@page

@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container two-columns">

        <div>
            <p class="small-title">
                Creative services for independent businesses
            </p>

            <h1>
                Make your business easier to understand and trust.
            </h1>

            <p class="large-text">
                Harakeke Studio provides photography,
                graphic design, consulting and personal branding.
            </p>

            <a class="button" asp-page="/Services">
                View our services
            </a>

            <a class="second-link" asp-page="/Contact">
                Contact us
            </a>
        </div>

        <img src="~/images/home.jpg"
             alt="Creative professional working in a design studio" />

    </div>
</section>

<section class="section container">

    <div class="section-title">
        <p class="small-title">Our services</p>
        <h2>How we can help</h2>
    </div>

    <div class="three-columns">

        <article class="card">
            <h3>Photography</h3>

            <p>
                Professional photographs for websites,
                products and personal brands.
            </p>
        </article>

        <article class="card">
            <h3>Graphic Design</h3>

            <p>
                Clear visual content for social media,
                presentations and printed material.
            </p>
        </article>

        <article class="card">
            <h3>Business Support</h3>

            <p>
                Practical advice for branding,
                content and communication.
            </p>
        </article>

    </div>
</section>

<section class="section light-section">

    <div class="container">
        <h2>Simple working process</h2>

        <div class="three-columns">

            <article class="step">
                <span>1</span>
                <h3>Discuss</h3>
                <p>We discuss your business and project goal.</p>
            </article>

            <article class="step">
                <span>2</span>
                <h3>Create</h3>
                <p>We prepare the agreed creative work.</p>
            </article>

            <article class="step">
                <span>3</span>
                <h3>Deliver</h3>
                <p>You receive the completed files.</p>
            </article>

        </div>
    </div>
</section>

<section class="contact-banner">
    <div class="container banner-content">

        <div>
            <h2>Have a project in mind?</h2>
            <p>Tell us what support you need.</p>
        </div>

        <a class="button gold-button" asp-page="/Contact">
            Start an enquiry
        </a>

    </div>
</section>