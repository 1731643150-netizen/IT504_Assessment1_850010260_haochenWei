@page
@model ContactModel

@{
    ViewData["Title"] = "Contact";
}

<section class="page-heading dark-heading">
    <div class="container">

        <p class="small-title light-text">Contact</p>

        <h1>Tell us about your project</h1>

        <p class="large-text">
            Complete the form below. We normally reply
            within two business days.
        </p>

    </div>
</section>

<section class="section container contact-grid">

    <div>
        <h2>Project enquiry</h2>

        @if (Model.SuccessMessage != null)
        {
            <div class="success-message" role="status">
                @Model.SuccessMessage
            </div>
        }

        <form method="post" class="contact-form">

            <div asp-validation-summary="ModelOnly"
                 class="error-message">
            </div>

            <div class="form-field">
                <label asp-for="Input.Name"></label>

                <input asp-for="Input.Name" />

                <span asp-validation-for="Input.Name"
                      class="error-message">
                </span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Email"></label>

                <input asp-for="Input.Email" />

                <span asp-validation-for="Input.Email"
                      class="error-message">
                </span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Service"></label>

                <select asp-for="Input.Service">
                    <option value="">Choose a service</option>
                    <option>Photography</option>
                    <option>Graphic Design</option>
                    <option>Consulting</option>
                    <option>Personal Branding</option>
                </select>

                <span asp-validation-for="Input.Service"
                      class="error-message">
                </span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Message"></label>

                <textarea asp-for="Input.Message"
                          rows="6">
                </textarea>

                <span asp-validation-for="Input.Message"
                      class="error-message">
                </span>
            </div>

            <button type="submit" class="button">
                Send message
            </button>

        </form>
    </div>

    <aside class="contact-information">

        <h2>What happens next?</h2>

        <ol>
            <li>We read your message.</li>
            <li>We confirm the project details.</li>
            <li>We provide a suitable option.</li>
        </ol>

        <h3>Email</h3>

        <p>hello@harakekestudio.nz</p>

        <h3>Response time</h3>

        <p>Within two business days.</p>

    </aside>
</section>