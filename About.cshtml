@page

@{
    ViewData["Title"] = "About";
}

<section class="page-heading">
    <div class="container">

        <p class="small-title">About us</p>

        <h1>
            Creative support with a clear process.
        </h1>

        <p class="large-text">
            Harakeke Studio helps freelancers and small
            businesses present their work professionally.
        </p>

    </div>
</section>

<section class="section container two-columns">

    <img src="~/images/about.jpg"
         alt="Creative materials arranged in a small studio" />

    <div>
        <p class="small-title">Our purpose</p>

        <h2>We make business ideas easier to understand.</h2>

        <p>
            Many small business owners provide good services
            but do not have enough time to create photographs,
            graphics and brand content.
        </p>

        <p>
            Harakeke Studio provides practical creative support.
            We listen to the client, agree on the work and provide
            clear progress updates.
        </p>

        <a class="button" asp-page="/Contact">
            Contact the studio
        </a>
    </div>

</section>

<section class="section light-section">

    <div class="container">
        <h2>Our values</h2>

        <div class="three-columns">

            <article class="card">
                <h3>Clarity</h3>

                <p>
                    We explain the work, price and timeline
                    in clear language.
                </p>
            </article>

            <article class="card">
                <h3>Respect</h3>

                <p>
                    We listen to the client and respect
                    their original ideas.
                </p>
            </article>

            <article class="card">
                <h3>Useful Results</h3>

                <p>
                    We create material that clients can
                    use in their business.
                </p>
            </article>

        </div>
    </div>
</section>