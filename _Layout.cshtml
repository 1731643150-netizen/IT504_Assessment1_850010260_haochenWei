<!DOCTYPE html>

<html lang="en-NZ">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Harakeke Studio creative services website." />

    <title>@ViewData["Title"] | Harakeke Studio</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <a class="skip-link" href="#main-content">
        Skip to main content
    </a>

    <header>
        <div class="container navigation">

            <a class="logo" asp-page="/Index">
                Harakeke Studio
            </a>

            <nav aria-label="Main navigation">
                <a asp-page="/Index">Home</a>
                <a asp-page="/About">About</a>
                <a asp-page="/Services">Services / Portfolio</a>
                <a asp-page="/Testimonials">Testimonials</a>
                <a asp-page="/Contact">Contact</a>
            </nav>

        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    <footer>
        <div class="container footer-content">

            <div>
                <h2>Harakeke Studio</h2>

                <p>
                    Creative services for freelancers and
                    small businesses.
                </p>
            </div>

            <div>
                <h3>Contact</h3>

                <p>hello@harakekestudio.nz</p>
                <p>Reply within two business days.</p>
            </div>

        </div>

        <p class="copyright">
            © @DateTime.Now.Year Harakeke Studio
        </p>
    </footer>
</body>
</html>